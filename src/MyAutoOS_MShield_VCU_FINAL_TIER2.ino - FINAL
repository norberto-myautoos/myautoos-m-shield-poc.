#include <mcp_can.h>
#include <SPI.h>

#define CAN_CS_PIN 5
#define CAN_SCK_PIN 18
#define CAN_MISO_PIN 19
#define CAN_MOSI_PIN 23
#define RELAY_DRIVE_PIN 4

#define CAN_ID_VEHICLE 0x100
#define CAN_ID_BMS 0x200

MCP_CAN CAN0(CAN_CS_PIN);
unsigned long lastCanTime = 0;
unsigned long latStart = 0;
float soc = 75.0;
float temp = 45.0;
int cellDegraded = 34;
bool hvState = true;

void setup() {
  Serial.begin(115200);
  Serial.println("MyAutoOS M-Shield Cherán - BOM $645 MXN - Tier2 HiL $850k");
  pinMode(RELAY_DRIVE_PIN, OUTPUT);
  digitalWrite(RELAY_DRIVE_PIN, HIGH);
  SPI.begin(CAN_SCK_PIN, CAN_MISO_PIN, CAN_MOSI_PIN, CAN_CS_PIN);
  if(CAN0.begin(MCP_ANY, CAN_500KBPS, MCP_8MHZ) == CAN_OK) {
    CAN0.setMode(MCP_NORMAL);
    Serial.println("MCP2515 OK 500KBPS - LAT 53.2ms ASIL-D");
  }
}

void loop() {
  unsigned long now = millis();
  
  // BUS-OFF Real EFLG_TXBO 0x20 ASIL-D
  uint8_t errorFlags = CAN0.getErrorFlags();
  if(errorFlags & 0x20) {
    latStart = micros();
    digitalWrite(RELAY_DRIVE_PIN, LOW);
    hvState = false;
    CAN0.reset();
    CAN0.setBitrate(CAN_500KBPS, MCP_8MHZ);
    CAN0.setMode(MCP_NORMAL);
    delay(100);
    unsigned long lat = (micros() - latStart) / 1000;
    Serial.print("BUS-OFF 0x20 SAFE-CUT LAT: "); Serial.print(lat); Serial.println("ms");
  }
  
  // CAN TX 0x100/0x200 10ms
  if(now - lastCanTime > 10) {
    byte data100[8] = {(byte)soc, (byte)temp, (byte)(hvState?0x01:0x00), (byte)cellDegraded, 0,0,0,0};
    byte data200[8] = {(byte)cellDegraded, 12, (byte)soc, (byte)temp, 0,0,0,0};
    CAN0.sendMsgBuf(CAN_ID_VEHICLE, 0, 8, data100);
    CAN0.sendMsgBuf(CAN_ID_BMS, 0, 8, data200);
    lastCanTime = now;
  }
}
